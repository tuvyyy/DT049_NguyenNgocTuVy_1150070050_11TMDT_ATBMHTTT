#!/usr/bin/env bash
# Only select an interpreter and an explicit default run; never train or select latest.
set -euo pipefail
DT049_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DT049_PYTHON="${DT049_ROOT}/.venv/bin/python"
if [[ ! -x "$DT049_PYTHON" ]]; then
    echo "DỪNG: không tìm thấy Python tại $DT049_PYTHON. Chuẩn bị đúng môi trường .venv trước khi demo." >&2
    exit 2
fi
export DT049_RUN="${DT049_RUN:-${DT049_ROOT}/runs/gru/20261018T114814_2e1846de}"
DT049_MODE="${1:-all}"
if [[ $# -gt 0 ]]; then shift; fi
case "$DT049_MODE" in
    1) DT049_MODE=log ;;
    2|res) DT049_MODE=result ;;
    3|atk) DT049_MODE=event ;;
    4|time) DT049_MODE=timeline ;;
    b-log) DT049_MODE=benchmark-log ;;
    b-th) DT049_MODE=benchmark-threshold ;;
esac
exec "$DT049_PYTHON" -B "${DT049_ROOT}/demo/show_event.py" "$DT049_MODE" "$@"
