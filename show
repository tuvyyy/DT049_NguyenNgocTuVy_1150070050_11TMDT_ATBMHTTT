#!/usr/bin/env bash
# Quick demo launcher for DT049 terminal walkthrough
set -e
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="${ROOT}/.venv/bin/python"

case "${1:-all}" in
    log|1)                    "$PYTHON" -B "${ROOT}/demo/show_event.py" log ;;
    result|2|res)             "$PYTHON" -B "${ROOT}/demo/show_event.py" result ;;
    event|3|atk)              "$PYTHON" -B "${ROOT}/demo/show_event.py" event ;;
    timeline|4|time)          "$PYTHON" -B "${ROOT}/demo/show_event.py" timeline ;;
    seeds)                    "$PYTHON" -B "${ROOT}/demo/show_event.py" seeds ;;
    all)                      "$PYTHON" -B "${ROOT}/demo/show_event.py" all ;;
    benchmark-log|b-log)      "$PYTHON" -B "${ROOT}/demo/show_event.py" benchmark-log ;;
    benchmark-threshold|b-th) "$PYTHON" -B "${ROOT}/demo/show_event.py" benchmark-threshold ;;
    *)                        "$PYTHON" -B "${ROOT}/demo/show_event.py" "$@" ;;
esac
